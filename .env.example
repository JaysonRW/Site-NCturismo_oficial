# ============================================================================
# CONFIGURAÇÃO DO MÓDULO RODOVIÁRIO — INTEGRAÇÃO QUERO PASSAGEM (ws_v4)
# Importante: Nunca utilize prefixo VITE_ para credenciais ou affiliateCode.
# ============================================================================
APP_ENV=development
APP_MODE=sandbox
APP_NAME=NC Turismo - Consulta e Emissão Rodoviária

# Ambientes permitidos: sandbox | production
# Host Sandbox Oficial: https://queropassagem.qpdevs.com/ws_v4
QP_ENV=sandbox
QP_USERNAME=
QP_PASSWORD=
QP_AFFILIATE_CODE=NCT

# Timeouts, Orçamento de Requisições (máx 100/min no fornecedor) e Cache (segundos)
QP_CONNECT_TIMEOUT_SECONDS=10
QP_READ_TIMEOUT_SECONDS=125
QP_MAX_REQUESTS_PER_MINUTE=90
QP_STOPS_CACHE_TTL_SECONDS=86400
QP_COMPANIES_CACHE_TTL_SECONDS=86400
QP_SEARCH_LOCAL_CACHE_TTL_SECONDS=60

# Feature Flags Operacionais (Habilitadas para Homologação Quero Passagem)
QP_ENABLE_CONNECTIONS=true
QP_ENABLE_BOOKING=true
QP_ENABLE_CHECKOUT=true
QP_ENABLE_CANCEL=true
QP_ENABLE_CARD=true
QP_ALLOW_PRODUCTION=false
QP_CALLBACK_URL=
